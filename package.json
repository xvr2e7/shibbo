{
  "name": "shibbo",
  "version": "0.1.0",
  "description": "A dated, model-aware registry of AI writing and design tells, with a checker that plugs into agent harnesses.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "shibbo": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "data/tells.yaml",
    "data/sources.yaml",
    "data/models.yaml",
    "data/measured",
    "plugins"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "import:graphite": "tsx scripts/import-graphite.ts",
    "validate": "tsx scripts/validate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "tsx scripts/eval-graphite.ts",
    "export": "tsx scripts/export.ts",
    "shibbo": "tsx src/cli.ts",
    "plugin": "tsx scripts/build-plugin.ts",
    "map": "tsx scripts/map-data.ts",
    "measure": "tsx measure/generate.ts",
    "analyze": "tsx measure/analyze.ts",
    "web:data": "tsx scripts/build-web-data.ts",
    "web:dev": "npm run web:data && vite web",
    "web:build": "npm run web:data && vitepress build docs && vite build web",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-timer": "^3.0.2",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "d3-array": "^3.2.5",
    "d3-contour": "^4.0.3",
    "d3-force": "^3.0.1",
    "d3-quadtree": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-timer": "^3.0.2",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitepress": "^1.6.4"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  }
}
